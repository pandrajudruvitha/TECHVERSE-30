# Local development only. Replace these values before starting the database.
POSTGRES_DB=techverse
POSTGRES_USER=techverse
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://techverse:change-me-local-only@localhost:5432/techverse
JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://localhost:6379/0

# Local service origins
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000

# Configure a provider key only in the backend environment when Stage 7 is implemented.
LLM_API_KEY=
