# Local development only. Replace these values before starting the database.
POSTGRES_DB=techverse
POSTGRES_USER=techverse
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://techverse:change-me-local-only@localhost:5432/techverse
JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://localhost:6379/0

# Local service origins
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000

# Stage 7 central AI engine. Provider credentials stay only in the backend environment.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=OpenAI-compatible
